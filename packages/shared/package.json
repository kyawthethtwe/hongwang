{
  "name": "@hongwang/shared",
  "version": "0.1.0",
  "private": true,
  "description": "API contract shared by web and api: zod schemas, enums, pricing, booking state machine, queue payloads.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./phone": {
      "types": "./dist/phone.d.ts",
      "import": "./dist/phone.js",
      "require": "./dist/phone.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "phone": [
        "./dist/phone.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.17",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
