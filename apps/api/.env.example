# Copy to apps/api/.env
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# docker compose: postgres://hongwang:hongwang@localhost:5433/hongwang (needs PostGIS + btree_gist)
DATABASE_URL=postgres://hongwang:hongwang@localhost:5433/hongwang
# Used by the e2e tests (booking concurrency). Created and migrated by the test setup.
DATABASE_URL_TEST=postgres://hongwang:hongwang@localhost:5433/hongwang_test
REDIS_URL=redis://localhost:6379

# openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Stripe test mode. Leave empty to use the simulated payment flow in development.
# Local webhooks: stripe listen --events payment_intent.succeeded,payment_intent.payment_failed,charge.refunded,refund.failed --forward-to localhost:4000/api/payments/webhook
# (prints the whsec_ value for STRIPE_WEBHOOK_SECRET). A Stripe webhook endpoint needs the same four events.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mailpit from docker compose (UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Hongwang <no-reply@hongwang.local>"

# Photo storage.
# - local (development): files go to apps/api/uploads and are served by the API.
# - s3 (staging and production): Cloudflare R2 or another S3-compatible bucket. With NODE_ENV=production
#   the API refuses to start unless STORAGE_DRIVER=s3 and every S3_* value below is set. The browser
#   PUTs uploads straight to the bucket, so its CORS rules must allow PUT (Content-Type header) from WEB_ORIGIN.
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=hongwang-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://photos.example.com

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# log: OTP codes are printed to the API log. (twilio later)
SMS_DRIVER=log

# Until the admin moderation queue exists (phase 2), submitted listings publish straight away.
AUTO_APPROVE_LISTINGS=true
