# Copy to apps/web/.env.local
# Where the Next server reaches the API (rewrites + server components).
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=Hongwang
# Free vector tiles for MapLibre (no key). Swap for MapTiler etc. in production.
# The Content-Security-Policy allows this URL's origin for the style, tiles, glyphs and sprites.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Space-separated origins the browser loads photos from and PUTs uploads to (Content-Security-Policy).
# Development: the API's local upload driver. Staging and production: the R2 S3 endpoint and the public
# bucket URL, e.g. "https://<account>.r2.cloudflarestorage.com https://photos.example.com".
STORAGE_ORIGINS=http://localhost:4000
